{
  "from": "@offset@",
  "size": "@limit@",
  "query": {
    "bool": {
      "must": [
        {
          "multi_match": {
            "query": "@keyword@",
            "fields": ["title^2", "content"],
            "fuzziness": "AUTO"
          }
        }
      ],
      "filter": {
        "bool": {
          "should": [
            @permissions_filter@
          ]
        }
      }
    }
  },
  "highlight": {
    "number_of_fragments": 2,
    "fragment_size": 150,
    "no_match_size": 0,
    "fields": {
      "content": {
        "pre_tags": ["<span class='searchMatchExcerpt'>"],
        "post_tags": ["</span>"]
      }
    }
  }
}
