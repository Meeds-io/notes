<configuration
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://www.exoplatform.org/xml/ns/kernel_1_2.xsd http://www.exoplatform.org/xml/ns/kernel_1_2.xsd"
   xmlns="http://www.exoplatform.org/xml/ns/kernel_1_2.xsd">

  <external-component-plugins>
    <target-component>org.exoplatform.commons.upgrade.UpgradeProductService</target-component>
    <component-plugin>
      <name>NoteHomePageIndexingUpgradePlugin</name>
      <set-method>addUpgradePlugin</set-method>
      <type>io.meeds.notes.upgrade.NoteHomePageIndexingUpgradePlugin</type>
      <description>Queue the note book home pages for indexing, they used to never be indexed at creation</description>
      <!-- Neither plugin.upgrade.target.version nor plugin.upgrade.execute.once is declared
           here: the plugin overrides shouldProceedToUpgrade to gate the execution on a dedicated
           setting of its own, so that every instance repairs its index once whatever the version
           it upgrades from. Both params are only read by the overridden base implementation,
           declaring them would have no effect. -->
      <init-params>
        <value-param>
          <name>product.group.id</name>
          <description>The groupId of the product</description>
          <value>org.exoplatform.platform</value>
        </value-param>
        <value-param>
          <name>plugin.execution.order</name>
          <description>The plugin execution order</description>
          <value>1</value>
        </value-param>
        <value-param>
          <name>plugin.upgrade.async.execution</name>
          <description>The plugin will be executed in an asynchronous mode</description>
          <value>true</value>
        </value-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>

</configuration>
